# Salesforce JWT bearer (Connected App + integration user)
SF_CLIENT_ID=
SF_USERNAME=
SF_LOGIN_URL=https://login.salesforce.com
# PEM private key for signing JWT (use \n for newlines in a single line), or set SF_PRIVATE_KEY_PATH
SF_PRIVATE_KEY=
# SF_PRIVATE_KEY_PATH=C:\secrets\salesforce\server.key

# Optional: override default Contact SOQL
# SF_SOQL=SELECT Id, Name, Custom_KPI__c FROM Account LIMIT 50

# Step 1 memory loader (summary.json + send-metadata.json under this tree)
EMAIL_MEMORY_DIR=email-history
EMAIL_MEMORY_WINDOW_DAYS=45

# ---------- Weekly Bedrock + Gmail drafts (V1) ----------

# AWS Bedrock (Sonnet 4.5)
# AWS_REGION=us-east-1
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5

# Google Workspace service account with domain-wide delegation
# Subject MUST be a real Workspace user mailbox in hopewithlove.org
GMAIL_SUBJECT=checkins@hopewithlove.org
GMAIL_FROM=Hope1Source Check-ins <checkins@hopewithlove.org>
# Reviewer that should see the draft when invoked manually (defaults to GMAIL_SUBJECT)
GMAIL_REVIEW_RECIPIENT=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key (use \n for newlines on a single line) OR set GOOGLE_PRIVATE_KEY_PATH
GOOGLE_PRIVATE_KEY=
# GOOGLE_PRIVATE_KEY_PATH=

# Salesforce field API names (override only if your org uses different names)
# SF_FIELD_SEND_FEEDBACK=Send_Feedback_Emails__c
# SF_FIELD_EMAIL_OPT_OUT=Email__c
# SF_FIELD_DO_NOT_CONTACT=Do_Not_Contact__c
# SF_FIELD_AI_INSIGHTS=AI_Insights_Enabled__c

# Historical_Data__c field API names (override only if your org uses different names)
# SF_HD_OBJECT=Historical_Data__c
# SF_HD_ACCOUNT=Account__c
# SF_HD_WEEK_START=Week_Start__c
# SF_HD_WEEK_END=Week_End__c
# SF_HD_DRAFT_ID=Gmail_Draft_Id__c
# SF_HD_THREAD_ID=Gmail_Thread_Id__c
# SF_HD_MODEL=Bedrock_Model__c
# SF_HD_HASH=Source_Data_Hash__c
# SF_HD_STATUS=Status__c

# Dry-run override
# WEEKLY_DRAFTS_DRY_RUN=true
# WEEKLY_DRAFTS_FIXTURE_PATH=fixtures/weekly-eligible-accounts.json
