# Salesforce JWT bearer (Connected App + integration user)
SF_CLIENT_ID=
SF_USERNAME=
SF_LOGIN_URL=https://login.salesforce.com
# PEM private key for signing JWT (use \n for newlines in a single line), or set SF_PRIVATE_KEY_PATH
SF_PRIVATE_KEY=
# SF_PRIVATE_KEY_PATH=C:\secrets\salesforce\server.key

# Optional: override default Contact SOQL
# SF_SOQL=SELECT Id, Name, Custom_KPI__c FROM Account LIMIT 50

# Step 1 memory loader (summary.json + send-metadata.json under this tree)
EMAIL_MEMORY_DIR=email-history
EMAIL_MEMORY_WINDOW_DAYS=45

# ---------- Weekly Bedrock + Gmail drafts (V1) ----------

# AWS Bedrock (Sonnet 4.5)
# AWS_REGION=us-east-1
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# Google Workspace service account with domain-wide delegation
# Subject MUST be a real Workspace user mailbox in hope1source.me
GMAIL_SUBJECT=checkins@hope1source.me
GMAIL_FROM=Hope1Source Check-ins <checkins@hope1source.me>
# Reviewer that should see the draft when invoked manually (defaults to GMAIL_SUBJECT)
GMAIL_REVIEW_RECIPIENT=
# Required before non-dry-run execution. Use Bethel Cafe in sandbox validation.
# HOP43_ALLOWED_ACCOUNT_NAMES=Bethel Cafe
# HOP43_ALLOWED_ACCOUNT_IDS=
# Keep false unless a reviewed production workflow intentionally processes all eligible accounts.
# HOP43_ALLOW_BROAD_RUN=false
# Keep false unless drafts should go directly to account contacts instead of reviewer inboxes.
# HOP43_ALLOW_ACCOUNT_RECIPIENTS=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key (use \n for newlines on a single line) OR set GOOGLE_PRIVATE_KEY_PATH
GOOGLE_PRIVATE_KEY=
# GOOGLE_PRIVATE_KEY_PATH=

# Salesforce eligibility field API names (override only if your org uses different names)
# Eligibility starts from Service Provider Contacts and groups to one draft per Account.
# SF_FIELD_ACCOUNT_AI_INSIGHTS=AI_Insights_Enabled__c
# SF_FIELD_SEND_FEEDBACK=Send_Feedback_Emails__c
# SF_FIELD_CONTACT_DO_NOT_CONTACT=npsp__Do_Not_Contact__c
# SF_FIELD_CONTACT_EMAIL=Email
# SF_FIELD_CONTACT_RECORD_TYPE=RecordType.DeveloperName
# SF_SERVICE_PROVIDER_RECORD_TYPE=Service_Provider
# SF_FIELD_LAST_FEEDBACK_EMAIL_SENT=Last_Feedback_Email_Sent__c
# Keep false unless the team explicitly approves Contact field updates.
# SF_STAMP_FEEDBACK_EMAIL_SENT=false

# Lambda-only: load private keys from AWS Secrets Manager at init.
# HOP43_SECRET_SOURCE=aws
# HOP43_SF_SECRET_ID=hope1source/hop43/salesforce-jwt
# HOP43_GOOGLE_SECRET_ID=hope1source/hop43/google-service-account

# Historical_Data__c field API names (override only if your org uses different names)
# SF_HD_OBJECT=Historical_Data__c
# SF_HD_ACCOUNT=Account__c
# SF_HD_DATE_OF_GENERATION=Date_of_Generation__c
# Optional if these fields exist in the org; left unset by default because Historical_Data__c uses Date_of_Generation__c.
# SF_HD_WEEK_START=
# SF_HD_WEEK_END=
# Optional draft metadata fields. Leave unset unless additive fields exist in the target org.
# SF_HD_DRAFT_ID=
# SF_HD_THREAD_ID=
# SF_HD_MODEL=
# SF_HD_HASH=
# SF_HD_STATUS=
# SF_HD_IDEMPOTENCY_WINDOW_DAYS=7

# Service_Provider_Feedback__c source object for recent client quotes / ratings
# SF_FEEDBACK_OBJECT=Service_Provider_Feedback__c
# SF_FEEDBACK_ACCOUNT=Account__c
# SF_FEEDBACK_CONTACT=Contact__c
# SF_FEEDBACK_SUBMISSION_DATE=Submission_Date__c
# SF_FEEDBACK_RATING=Rating__c
# SF_FEEDBACK_DESCRIPTION=Description__c
# SF_FEEDBACK_HOPEFUL=How_Hopeful_Are_You__c
# SF_FEEDBACK_MORE_HOPEFUL=What_would_make_you_more_hopeful__c
# SF_FEEDBACK_WINDOW_DAYS=7

# Dry-run override
# WEEKLY_DRAFTS_DRY_RUN=true
# WEEKLY_DRAFTS_FIXTURE_DRAFT_ONLY=true
# WEEKLY_DRAFTS_FIXTURE_PATH=fixtures/weekly-eligible-accounts.json
